digraph G {
rankdir=BT; dpi=200; nodesep=0.35; ranksep=0.7; splines=true; fontname="DejaVu Sans";
labelloc=t; fontsize=26; label="Observer - alertas de variação de preço";
node [shape=plain, fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=9];
"RepositorioArquivo<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#DCE9F7" ALIGN="CENTER">&lt;&lt;abstract&gt;&gt;<BR/><B><I>RepositorioArquivo&lt;T&gt;</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- diretorioBase: File {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ adicionar(T) {final}<BR ALIGN="LEFT"/>+ atualizar(T) {final}<BR ALIGN="LEFT"/>+ deletar(int) {final}<BR ALIGN="LEFT"/>+ lerLista(): ArrayList&lt;T&gt; {final}<BR ALIGN="LEFT"/>+ salvarLista(ArrayList&lt;T&gt;) {final}<BR ALIGN="LEFT"/>+ gerarId(): int {final}<BR ALIGN="LEFT"/>+ buscarPorId(int): T {final}<BR ALIGN="LEFT"/># caminhoArquivo(): String {abstract}<BR ALIGN="LEFT"/># validar(T)<BR ALIGN="LEFT"/># validarAtualizacao(T, T)<BR ALIGN="LEFT"/># validarRemocao(T)<BR ALIGN="LEFT"/># aposAdicionar(T)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ArquivoHistoricoPreco" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#DCE9F7" ALIGN="CENTER"><B>ArquivoHistoricoPreco</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ INSTANCE {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># caminhoArquivo(): String<BR ALIGN="LEFT"/># validar(HistoricoPreco)<BR ALIGN="LEFT"/># aposAdicionar(HistoricoPreco)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"HistoricoPrecosUI" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#F6DDE3" ALIGN="CENTER"><B>HistoricoPrecosUI</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- alertaAumento: ObservadorPreco<BR ALIGN="LEFT"/>- alertaMenorPreco: ObservadorPreco<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- exibirAlerta(String)<BR ALIGN="LEFT"/># lerFormulario(int): HistoricoPreco<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"MonitorPrecos" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#F6DDE3" ALIGN="CENTER"><B>MonitorPrecos (Subject)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ INSTANCE: MonitorPrecos {static}<BR ALIGN="LEFT"/>- observadores: List&lt;ObservadorPreco&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registrar(ObservadorPreco)<BR ALIGN="LEFT"/>+ remover(ObservadorPreco)<BR ALIGN="LEFT"/>+ notificar(VariacaoPreco)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ObservadorPreco" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#F6DDE3" ALIGN="CENTER">&lt;&lt;interface&gt;&gt;<BR/><B>ObservadorPreco</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ precoRegistrado(VariacaoPreco)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"VariacaoPreco" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#F6DDE3" ALIGN="CENTER"><B>VariacaoPreco</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idProduto: int<BR ALIGN="LEFT"/>- precoAnterior: Double<BR ALIGN="LEFT"/>- menorPrecoAnterior: Double<BR ALIGN="LEFT"/>- precoNovo: double<BR ALIGN="LEFT"/>- data: LocalDate<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ variacaoPercentual(): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"AlertaAumentoPreco" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#F6DDE3" ALIGN="CENTER"><B>AlertaAumentoPreco</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- limitePercentual: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ precoRegistrado(VariacaoPreco)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"AlertaMenorPreco" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#F6DDE3" ALIGN="CENTER"><B>AlertaMenorPreco</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ precoRegistrado(VariacaoPreco)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RegistroAlertasLog" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#F6DDE3" ALIGN="CENTER"><B>RegistroAlertasLog</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- caminho: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ precoRegistrado(VariacaoPreco)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Main" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#F2F2F2" ALIGN="CENTER"><B>Main</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ start(Stage)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ArquivoHistoricoPreco" -> "RepositorioArquivo<T>" [arrowhead=empty];
"ArquivoHistoricoPreco" -> "MonitorPrecos" [arrowhead=vee, style=dashed, label="notificar()"];
"ArquivoHistoricoPreco" -> "VariacaoPreco" [arrowhead=vee, style=dashed, label="cria"];
"MonitorPrecos" -> "ObservadorPreco" [arrowhead=vee, arrowtail=odiamond, dir=both, label="observadores *"];
"MonitorPrecos" -> "VariacaoPreco" [arrowhead=vee, style=dashed];
"AlertaAumentoPreco" -> "ObservadorPreco" [arrowhead=empty, style=dashed];
"AlertaMenorPreco" -> "ObservadorPreco" [arrowhead=empty, style=dashed];
"RegistroAlertasLog" -> "ObservadorPreco" [arrowhead=empty, style=dashed];
"HistoricoPrecosUI" -> "MonitorPrecos" [arrowhead=vee, style=dashed, label="registrar/remover"];
"HistoricoPrecosUI" -> "AlertaAumentoPreco" [arrowhead=vee];
"HistoricoPrecosUI" -> "AlertaMenorPreco" [arrowhead=vee];
"Main" -> "RegistroAlertasLog" [arrowhead=vee, style=dashed, label="registra"];
}