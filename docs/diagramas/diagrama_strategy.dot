digraph G {
rankdir=BT; dpi=200; nodesep=0.35; ranksep=0.7; splines=true; fontname="DejaVu Sans";
labelloc=t; fontsize=26; label="Strategy - critérios de ordenação das listagens";
node [shape=plain, fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=9];
"Identificavel" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#F2F2F2" ALIGN="CENTER">&lt;&lt;interface&gt;&gt;<BR/><B>Identificavel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getId(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"CrudUI<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#DCE9F7" ALIGN="CENTER">&lt;&lt;abstract&gt;&gt;<BR/><B><I>CrudUI&lt;T&gt;</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># txtId: TextField<BR ALIGN="LEFT"/># tabela: TableView&lt;T&gt;<BR ALIGN="LEFT"/>- cmbOrdenacao: ComboBox&lt;EstrategiaOrdenacao&lt;T&gt;&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># montar() {final}<BR ALIGN="LEFT"/>- adicionar() / atualizar() / deletar()<BR ALIGN="LEFT"/># limpar() {final}<BR ALIGN="LEFT"/># carregarTabela() {final}<BR ALIGN="LEFT"/># titulo(): String {abstract}<BR ALIGN="LEFT"/># repositorio(): RepositorioArquivo&lt;T&gt; {abstract}<BR ALIGN="LEFT"/># configurarColunas(TableView&lt;T&gt;) {abstract}<BR ALIGN="LEFT"/># camposFormulario(): List&lt;Node&gt; {abstract}<BR ALIGN="LEFT"/># lerFormulario(int): T {abstract}<BR ALIGN="LEFT"/># preencherFormulario(T) {abstract}<BR ALIGN="LEFT"/># limparFormulario() {abstract}<BR ALIGN="LEFT"/># estrategiasOrdenacao(): List&lt;EstrategiaOrdenacao&lt;T&gt;&gt; {abstract}<BR ALIGN="LEFT"/># podeEditar(T) / podeExcluir(T)<BR ALIGN="LEFT"/># botoesExtras() / aoMudarSelecao(T)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"EstrategiaOrdenacao<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#FBEFD0" ALIGN="CENTER">&lt;&lt;interface&gt;&gt;<BR/><B>EstrategiaOrdenacao&lt;T&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getNome(): String<BR ALIGN="LEFT"/>+ ordenar(List&lt;T&gt;): List&lt;T&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"OrdenacaoPorComparador<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#FBEFD0" ALIGN="CENTER">&lt;&lt;abstract&gt;&gt;<BR/><B><I>OrdenacaoPorComparador&lt;T&gt;</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nome: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ordenar(List&lt;T&gt;): List&lt;T&gt;<BR ALIGN="LEFT"/># comparador(): Comparator&lt;T&gt; {abstract}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"OrdenacaoPorId<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#FBEFD0" ALIGN="CENTER"><B>OrdenacaoPorId&lt;T&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># comparador(): Comparator&lt;T&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"OrdenacaoPorTexto<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#FBEFD0" ALIGN="CENTER"><B>OrdenacaoPorTexto&lt;T&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># comparador(): Comparator&lt;T&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"OrdenacaoPorNumero<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#FBEFD0" ALIGN="CENTER"><B>OrdenacaoPorNumero&lt;T&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># comparador(): Comparator&lt;T&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"OrdenacaoPorData<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#FBEFD0" ALIGN="CENTER"><B>OrdenacaoPorData&lt;T&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># comparador(): Comparator&lt;T&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"CrudUI<T>" -> "EstrategiaOrdenacao<T>" [arrowhead=vee, arrowtail=odiamond, dir=both, label="estratégia atual"];
"OrdenacaoPorComparador<T>" -> "EstrategiaOrdenacao<T>" [arrowhead=empty, style=dashed];
"OrdenacaoPorId<T>" -> "OrdenacaoPorComparador<T>" [arrowhead=empty];
"OrdenacaoPorTexto<T>" -> "OrdenacaoPorComparador<T>" [arrowhead=empty];
"OrdenacaoPorNumero<T>" -> "OrdenacaoPorComparador<T>" [arrowhead=empty];
"OrdenacaoPorData<T>" -> "OrdenacaoPorComparador<T>" [arrowhead=empty];
"OrdenacaoPorId<T>" -> "Identificavel" [arrowhead=vee, style=dashed, label="T extends"];
}