digraph G {
rankdir=BT; dpi=200; nodesep=0.35; ranksep=0.7; splines=true; fontname="DejaVu Sans";
labelloc=t; fontsize=26; label="Template Method - repositórios e telas CRUD";
node [shape=plain, fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=9];
"Identificavel" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#F2F2F2" ALIGN="CENTER">&lt;&lt;interface&gt;&gt;<BR/><B>Identificavel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getId(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RepositorioArquivo<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#DCE9F7" ALIGN="CENTER">&lt;&lt;abstract&gt;&gt;<BR/><B><I>RepositorioArquivo&lt;T&gt;</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- diretorioBase: File {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ adicionar(T) {final}<BR ALIGN="LEFT"/>+ atualizar(T) {final}<BR ALIGN="LEFT"/>+ deletar(int) {final}<BR ALIGN="LEFT"/>+ lerLista(): ArrayList&lt;T&gt; {final}<BR ALIGN="LEFT"/>+ salvarLista(ArrayList&lt;T&gt;) {final}<BR ALIGN="LEFT"/>+ gerarId(): int {final}<BR ALIGN="LEFT"/>+ buscarPorId(int): T {final}<BR ALIGN="LEFT"/># caminhoArquivo(): String {abstract}<BR ALIGN="LEFT"/># validar(T)<BR ALIGN="LEFT"/># validarAtualizacao(T, T)<BR ALIGN="LEFT"/># validarRemocao(T)<BR ALIGN="LEFT"/># aposAdicionar(T)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RepositorioComEstado<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#DCE9F7" ALIGN="CENTER">&lt;&lt;abstract&gt;&gt;<BR/><B><I>RepositorioComEstado&lt;T&gt;</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># validarAtualizacao(T, T)<BR ALIGN="LEFT"/># validarRemocao(T)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ArquivoProduto" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#DCE9F7" ALIGN="CENTER"><B>ArquivoProduto<BR/>(idem: Categoria, ContaSuporte,<BR/>Fornecedor, MetaConsumo, Receita)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ INSTANCE: ArquivoProduto {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># caminhoArquivo(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ArquivoTicketSuporte" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#DCE9F7" ALIGN="CENTER"><B>ArquivoTicketSuporte<BR/>(idem: ListaCompras, Estoque)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ INSTANCE {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># caminhoArquivo(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ArquivoHistoricoPreco" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#DCE9F7" ALIGN="CENTER"><B>ArquivoHistoricoPreco</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ INSTANCE {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># caminhoArquivo(): String<BR ALIGN="LEFT"/># validar(HistoricoPreco)<BR ALIGN="LEFT"/># aposAdicionar(HistoricoPreco)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"CrudUI<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#DCE9F7" ALIGN="CENTER">&lt;&lt;abstract&gt;&gt;<BR/><B><I>CrudUI&lt;T&gt;</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># txtId: TextField<BR ALIGN="LEFT"/># tabela: TableView&lt;T&gt;<BR ALIGN="LEFT"/>- cmbOrdenacao: ComboBox&lt;EstrategiaOrdenacao&lt;T&gt;&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># montar() {final}<BR ALIGN="LEFT"/>- adicionar() / atualizar() / deletar()<BR ALIGN="LEFT"/># limpar() {final}<BR ALIGN="LEFT"/># carregarTabela() {final}<BR ALIGN="LEFT"/># titulo(): String {abstract}<BR ALIGN="LEFT"/># repositorio(): RepositorioArquivo&lt;T&gt; {abstract}<BR ALIGN="LEFT"/># configurarColunas(TableView&lt;T&gt;) {abstract}<BR ALIGN="LEFT"/># camposFormulario(): List&lt;Node&gt; {abstract}<BR ALIGN="LEFT"/># lerFormulario(int): T {abstract}<BR ALIGN="LEFT"/># preencherFormulario(T) {abstract}<BR ALIGN="LEFT"/># limparFormulario() {abstract}<BR ALIGN="LEFT"/># estrategiasOrdenacao(): List&lt;EstrategiaOrdenacao&lt;T&gt;&gt; {abstract}<BR ALIGN="LEFT"/># podeEditar(T) / podeExcluir(T)<BR ALIGN="LEFT"/># botoesExtras() / aoMudarSelecao(T)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"CrudComEstadoUI<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#DCE9F7" ALIGN="CENTER">&lt;&lt;abstract&gt;&gt;<BR/><B><I>CrudComEstadoUI&lt;T&gt;</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># txtStatus: TextField<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># estadoInicial(): EstadoStatus {abstract}<BR ALIGN="LEFT"/># statusParaGravar(): String<BR ALIGN="LEFT"/># podeEditar(T) / podeExcluir(T)<BR ALIGN="LEFT"/># botoesExtras() / aoMudarSelecao(T)<BR ALIGN="LEFT"/>- transicionar(boolean)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ProdutoUI" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#DCE9F7" ALIGN="CENTER"><B>ProdutoUI<BR/>(idem: CategoriaUI, ContaSuporteUI,<BR/>FornecedorUI, MetaConsumoUI, ReceitaUI)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># lerFormulario(int): Produto<BR ALIGN="LEFT"/># estrategiasOrdenacao()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"TicketSuporteUI" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#DCE9F7" ALIGN="CENTER"><B>TicketSuporteUI<BR/>(idem: ListaComprasUI, EstoqueUI)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># estadoInicial()<BR ALIGN="LEFT"/># lerFormulario(int)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"HistoricoPrecosUI" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#F6DDE3" ALIGN="CENTER"><B>HistoricoPrecosUI</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- alertaAumento: ObservadorPreco<BR ALIGN="LEFT"/>- alertaMenorPreco: ObservadorPreco<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- exibirAlerta(String)<BR ALIGN="LEFT"/># lerFormulario(int): HistoricoPreco<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Produto" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#F2F2F2" ALIGN="CENTER"><B>Produto<BR/>(idem: Categoria, ContaSuporte,<BR/>Fornecedor, MetaConsumo, Receita)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"HistoricoPreco" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#F2F2F2" ALIGN="CENTER"><B>HistoricoPreco</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idProduto: int<BR ALIGN="LEFT"/>- preco: double<BR ALIGN="LEFT"/>- data: LocalDate<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"ComEstado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER">&lt;&lt;interface&gt;&gt;<BR/><B>ComEstado</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getStatus(): String<BR ALIGN="LEFT"/>+ getEstado(): EstadoStatus<BR ALIGN="LEFT"/>+ avancarStatus()<BR ALIGN="LEFT"/>+ voltarStatus()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ArquivoProduto" -> "RepositorioArquivo<T>" [arrowhead=empty];
"ArquivoHistoricoPreco" -> "RepositorioArquivo<T>" [arrowhead=empty];
"RepositorioComEstado<T>" -> "RepositorioArquivo<T>" [arrowhead=empty];
"ArquivoTicketSuporte" -> "RepositorioComEstado<T>" [arrowhead=empty];
"RepositorioArquivo<T>" -> "Identificavel" [arrowhead=vee, style=dashed, label="T extends"];
"Produto" -> "Identificavel" [arrowhead=empty, style=dashed];
"HistoricoPreco" -> "Identificavel" [arrowhead=empty, style=dashed];
"ComEstado" -> "Identificavel" [arrowhead=empty];
"RepositorioComEstado<T>" -> "ComEstado" [arrowhead=vee, style=dashed, label="T extends"];
"ProdutoUI" -> "CrudUI<T>" [arrowhead=empty];
"HistoricoPrecosUI" -> "CrudUI<T>" [arrowhead=empty];
"CrudComEstadoUI<T>" -> "CrudUI<T>" [arrowhead=empty];
"TicketSuporteUI" -> "CrudComEstadoUI<T>" [arrowhead=empty];
"CrudUI<T>" -> "RepositorioArquivo<T>" [arrowhead=vee, label="repositorio()"];
"CrudComEstadoUI<T>" -> "ComEstado" [arrowhead=vee, style=dashed, label="T extends"];
}