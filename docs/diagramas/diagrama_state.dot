digraph G {
rankdir=BT; dpi=200; nodesep=0.35; ranksep=0.7; splines=true; fontname="DejaVu Sans";
labelloc=t; fontsize=26; label="State - status de Ticket, Lista de Compras e Estoque";
node [shape=plain, fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=9];
"Identificavel" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#F2F2F2" ALIGN="CENTER">&lt;&lt;interface&gt;&gt;<BR/><B>Identificavel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getId(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"RepositorioComEstado<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#DCE9F7" ALIGN="CENTER">&lt;&lt;abstract&gt;&gt;<BR/><B><I>RepositorioComEstado&lt;T&gt;</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># validarAtualizacao(T, T)<BR ALIGN="LEFT"/># validarRemocao(T)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ComEstado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER">&lt;&lt;interface&gt;&gt;<BR/><B>ComEstado</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getStatus(): String<BR ALIGN="LEFT"/>+ getEstado(): EstadoStatus<BR ALIGN="LEFT"/>+ avancarStatus()<BR ALIGN="LEFT"/>+ voltarStatus()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"EstadoStatus" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER">&lt;&lt;interface&gt;&gt;<BR/><B>EstadoStatus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getNome(): String<BR ALIGN="LEFT"/>+ proximo(): EstadoStatus<BR ALIGN="LEFT"/>+ anterior(): EstadoStatus<BR ALIGN="LEFT"/>+ rotuloAvancar(): String<BR ALIGN="LEFT"/>+ permiteAvancar() / permiteVoltar()<BR ALIGN="LEFT"/>+ permiteEdicao(): boolean<BR ALIGN="LEFT"/>+ permiteExclusao(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"TicketSuporte" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER"><B>TicketSuporte (Context)<BR/>(idem: ListaCompras, Estoque)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- status: String<BR ALIGN="LEFT"/>- estado: EstadoStatus {transient}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getEstado(): EstadoStatus<BR ALIGN="LEFT"/>+ avancarStatus()<BR ALIGN="LEFT"/>+ voltarStatus()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"EstadosTicket" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER"><B>EstadosTicket<BR/>(idem: EstadosLista, EstadosEstoque)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ inicial(): EstadoStatus {static}<BR ALIGN="LEFT"/>+ de(String): EstadoStatus {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"TicketAberto" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER"><B>TicketAberto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"TicketEmAndamento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER"><B>TicketEmAndamento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"TicketResolvido" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER"><B>TicketResolvido</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"TicketFechado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER"><B>TicketFechado</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"ListaEmElaboracao" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER"><B>ListaEmElaboracao</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"ListaFinalizada" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER"><B>ListaFinalizada</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"ListaComprada" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER"><B>ListaComprada</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"EstoqueAtivo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER"><B>EstoqueAtivo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"EstoqueInativo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER"><B>EstoqueInativo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"EstoqueArquivado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E3F3E0" ALIGN="CENTER"><B>EstoqueArquivado</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"ComEstado" -> "Identificavel" [arrowhead=empty];
"RepositorioComEstado<T>" -> "ComEstado" [arrowhead=vee, style=dashed, label="T extends"];
"TicketSuporte" -> "ComEstado" [arrowhead=empty, style=dashed];
"TicketSuporte" -> "EstadoStatus" [arrowhead=vee, arrowtail=odiamond, dir=both, label="estado"];
"TicketSuporte" -> "EstadosTicket" [arrowhead=vee, style=dashed, label="reconstrói"];
"EstadosTicket" -> "EstadoStatus" [arrowhead=vee, style=dashed, label="cria"];
"TicketAberto" -> "EstadoStatus" [arrowhead=empty, style=dashed];
"TicketEmAndamento" -> "EstadoStatus" [arrowhead=empty, style=dashed];
"TicketResolvido" -> "EstadoStatus" [arrowhead=empty, style=dashed];
"TicketFechado" -> "EstadoStatus" [arrowhead=empty, style=dashed];
"ListaEmElaboracao" -> "EstadoStatus" [arrowhead=empty, style=dashed];
"ListaFinalizada" -> "EstadoStatus" [arrowhead=empty, style=dashed];
"ListaComprada" -> "EstadoStatus" [arrowhead=empty, style=dashed];
"EstoqueAtivo" -> "EstadoStatus" [arrowhead=empty, style=dashed];
"EstoqueInativo" -> "EstadoStatus" [arrowhead=empty, style=dashed];
"EstoqueArquivado" -> "EstadoStatus" [arrowhead=empty, style=dashed];
"TicketAberto" -> "TicketEmAndamento" [arrowhead=vee, style=dashed, color="#2E7D32", fontcolor="#2E7D32", label="proximo()", constraint=false];
"TicketEmAndamento" -> "TicketResolvido" [arrowhead=vee, style=dashed, color="#2E7D32", fontcolor="#2E7D32", label="proximo()", constraint=false];
"TicketResolvido" -> "TicketFechado" [arrowhead=vee, style=dashed, color="#2E7D32", fontcolor="#2E7D32", label="proximo()", constraint=false];
"ListaEmElaboracao" -> "ListaFinalizada" [arrowhead=vee, style=dashed, color="#2E7D32", fontcolor="#2E7D32", label="proximo()", constraint=false];
"ListaFinalizada" -> "ListaComprada" [arrowhead=vee, style=dashed, color="#2E7D32", fontcolor="#2E7D32", label="proximo()", constraint=false];
"EstoqueAtivo" -> "EstoqueInativo" [arrowhead=vee, style=dashed, color="#2E7D32", fontcolor="#2E7D32", label="proximo()", constraint=false];
"EstoqueInativo" -> "EstoqueArquivado" [arrowhead=vee, style=dashed, color="#2E7D32", fontcolor="#2E7D32", label="proximo()", constraint=false];
}